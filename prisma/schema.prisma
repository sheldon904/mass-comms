generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @default(cuid())
  name      String
  filename  String
  research  String
  summary   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  emails    Email[]
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emails    Email[]
}

model Email {
  id        String    @id @default(cuid())
  subject   String
  body      String
  status    String    @default("draft")
  purpose   String?
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sentAt    DateTime?
  resendId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
